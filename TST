    ["ExpName"]           = "RPG", ["ExpRadius"] = 12, ["BoatDamage"] = 300,
    ["TankDamage"]        = 300, ["Acceleration"] = 8, ["ShieldDamage"] = 170,
    ["Distance"]          = 4000, ["PlaneDamage"] = 500, ["GunshipDamage"] = 170,
    ["velocity"]          = 200, ["ExplosionDamage"] = 120,
}

local function fireRPG_Explode(target, weaponName, tool)
    local r = remotes.RPG
    if not r then return end
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local myPos = myHrp.Position
    local targetPos = target.headPosition or target.hrpPosition
    local direction = (targetPos - myPos).Unit
    r.FireRocket:InvokeServer(direction, tool, tool, targetPos)
    if target.head and r.RocketHit then
        r.RocketHit:FireServer(targetPos, direction, tool, tool, target.head, target.head, LocalPlayer.Name.."_RK_"..math.random(100000,999999))
    end
end

local function fireRPG_Rocket(target, weaponName, tool)
    local r = remotes.RPG
    if not r then return end
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local myPos = myHrp.Position
    local targetPos = target.headPosition or target.hrpPosition
    local direction = (targetPos - myPos).Unit
    r.FireRocket:InvokeServer(direction, tool, tool, targetPos)
    if r.FireRocketClient and r.RocketModel then
        r.FireRocketClient:Fire(targetPos, direction, RPG_PAYLOAD, r.RocketModel, tool, tool, LocalPlayer)
    end
end

local function fireBullet(target, weaponName, tool, loc)
    local b = remotes.Bullet
    if not b then return end
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local myPos = myHrp.Position
    local targetPos = target.headPosition or target.hrpPosition
    local direction = (targetPos - myPos).Unit
    local nilWep = getNilInstance("S"..weaponName) or getNilInstance(weaponName)
    b.FireGun:FireServer({ direction }, tool, nilWep or tool, targetPos, false)
    if b.HitEvent and target.head then
        b.HitEvent:FireServer(targetPos, { direction }, tool, nilWep or tool, target.head, target.head, LocalPlayer.Name.."_BL_"..math.random(100000,999999))
    end
end

-- ============================================================================
--  MAIN LOOP
-- ============================================================================
local function execute()
    if not enabled then return end
    local tool, weaponName, loc = getActiveWeapon()
    if not tool then
        if autoEquip then equipBestWeapon() end
        return
    end
    if isRPG(weaponName) then
        if not initRPG() then return end
    else
        if not initBullet() then return end
    end
    local targets = selectTargets()
    if #targets == 0 then return end
    for _, target in ipairs(targets) do
        if not enabled then break end
        if not target.head and not target.hrp then goto continue_target end
        for _ = 1, shotsPerTick do
            if not enabled then break end
            if isRPG(weaponName) then
                if mode == "Explode" then fireRPG_Explode(target, weaponName, tool)
                else fireRPG_Rocket(target, weaponName, tool) end
            else
                fireBullet(target, weaponName, tool, loc)
            end
        end
        ::continue_target::
    end
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
    if not enabled then acc = 0; return end
    local interval = math.max(0.01, 1/spamSpeed)
    acc = acc + dt
    if acc >= interval then acc = acc - interval; execute() end
end)

-- ============================================================================
--  COREGUI INJECTION — multiple fallbacks for every executor
-- ============================================================================
local function getCoreGuiParent()
    -- Method 1: gethui() — Fluxus, KRNL, Hydrogen, Vega X
    local ok, result = pcall(function() return gethui() end)
    if ok and result then return result end

    -- Method 2: syn.protect_gui() — Synapse X
    ok, result = pcall(function()
        local sg = Instance.new("ScreenGui")
        syn.protect_gui(sg)
        sg.Parent = game:GetService("CoreGui")
        return sg.Parent
    end)
    if ok and result then return result end

    -- Method 3: cloneref + CoreGui — ScriptWare
    ok, result = pcall(function()
        return cloneref(game:GetService("CoreGui"))
    end)
    if ok and result then return result end

    -- Method 4: game:GetService("CoreGui") — Standard
    ok, result = pcall(function() return game:GetService("CoreGui") end)
    if ok and result then return result end

    -- Method 5: game.CoreGui — Older executors
    ok, result = pcall(function() return game.CoreGui end)
    if ok and result then return result end

    -- Final fallback: PlayerGui
    return LocalPlayer:WaitForChild("PlayerGui")
end

