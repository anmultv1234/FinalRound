-- ============================================================================
--  TOGGLE LOGIC
-- ============================================================================
local function setEnabled(val)
    enabled = val
    if enabled then
        StatusLabel.Text = "ON"
        StatusLabel.TextColor3 = Color3.fromRGB(60, 255, 60)
        ToggleBtn.Text = "DISABLE"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 180, 30)
    else
        StatusLabel.Text = "OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        ToggleBtn.Text = "ENABLE"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
    end
end

-- Button click (mobile tap)
