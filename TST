local RPG_PAYLOAD = {
    ["expShake"]          = { ["fadeInTime"]=0.05, ["magnitude"]=3, ["rotInfluence"]={0.4,0,0.4}, ["fadeOutTime"]=0.5, ["posInfluence"]={1,1,0}, ["roughness"]=3 },
    ["gravity"]           = Vector3.new(0, -20, 0),
