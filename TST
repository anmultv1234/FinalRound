for _, v in ipairs(WEAPON_PRIORITY) do ALL_RANGED[v] = true end

local function isRPG(name)
    for _, v in ipairs(RPG_WEAPONS) do if v == name then return true end end
    return false
end

-- ============================================================================
--  nil INSTANCE CACHE
-- ============================================================================
local nilCache = {}

local function getNilInstance(pattern)
    if nilCache[pattern] then
        local ok = pcall(function() local _ = nilCache[pattern].Name end)
        if ok then return nilCache[pattern] end
        nilCache[pattern] = nil
    end
    local ok, instances = pcall(function() return getnilinstances() end)
    if ok and instances then
        for _, obj in ipairs(instances) do
            if obj.Name == pattern or obj.Name:find(pattern) then
                nilCache[pattern] = obj
                return obj
            end
        end
    end
    local bfs = ReplicatedStorage:FindFirstChild("BulletFireSystem")
    if bfs then
        for _, child in ipairs(bfs:GetDescendants()) do
            if (child:IsA("Model") or child:IsA("Tool") or child:IsA("BasePart"))
                and (child.Name == pattern or child.Name:find(pattern)) then
                nilCache[pattern] = child
                return child
            end
        end
    end
    return nil
end

-- ============================================================================
--  REMOTE CACHE
-- ============================================================================
local remotes = {}

local function initRPG()
    if remotes.RPG then return true end
    pcall(function()
        local rs = ReplicatedStorage:WaitForChild("RocketSystem")
        local ev = rs:WaitForChild("Events")
        remotes.RPG = {
            FireRocket       = ev:WaitForChild("FireRocket"),
            FireRocketClient = ev:WaitForChild("FireRocketClient"),
            RocketHit        = ev:WaitForChild("RocketHit"),
            RocketModel      = rs:WaitForChild("Rockets"):FindFirstChild("RPG Rocket"),
        }
    end)
    return remotes.RPG ~= nil
end

local function initBullet()
    if remotes.Bullet then return true end
    pcall(function()
        local bfs = ReplicatedStorage:WaitForChild("BulletFireSystem")
        remotes.Bullet = {
            FireGun   = bfs:WaitForChild("FireGun"),
            HitEvent  = bfs:FindFirstChild("HitEvent")
                     or bfs:FindFirstChild("BulletHit")
                     or bfs:FindFirstChild("OnHit"),
        }
    end)
    return remotes.Bullet ~= nil
end

-- ============================================================================
--  WEAPON UTILS
-- ============================================================================
local function findWeaponAnywhere(name)
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool, "Character" end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local tool = bp:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool, "Backpack" end
    end
    return nil, nil
end

local function getActiveWeapon()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    for _, name in ipairs(WEAPON_PRIORITY) do
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool, name, "Character" end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, name in ipairs(WEAPON_PRIORITY) do
            local tool = bp:FindFirstChild(name)
            if tool and tool:IsA("Tool") then return tool, name, "Backpack" end
        end
    end
    return nil, nil, nil
end

local function equipBestWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    local _, currentName, loc = getActiveWeapon()
    if currentName and loc == "Character" then return currentName end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, name in ipairs(WEAPON_PRIORITY) do
        local tool = bp:FindFirstChild(name)
        if tool and tool:IsA("Tool") then
            humanoid:EquipTool(tool)
            return name
        end
    end
    return nil
end

-- ============================================================================
--  TEAM & TARGET
-- ============================================================================
local function getTeamTag(player)
    if player.Team then return player.Team end
    if player.TeamColor then return tostring(player.TeamColor) end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local t = ls:FindFirstChild("Team")
        if t then return t.Value end
    end
    return nil
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if not teamCheck then return true end
    local mt = getTeamTag(LocalPlayer)
    local tt = getTeamTag(player)
    if not mt or not tt then return true end
    return mt ~= tt
end

local function getPlayerHead(player)
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getAllEnemiesInRange()
    local myChar = LocalPlayer.Character
    if not myChar then return {} end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return {} end
    local myPos = myHrp.Position
    local enemies = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = getPlayerHead(player)
                if hrp then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist <= killRange then
                        table.insert(enemies, {
                            player       = player,
                            distance     = dist,
                            head         = head,
                            headPosition = head and head.Position or hrp.Position,
                            hrp          = hrp,
                            hrpPosition  = hrp.Position,
                        })
                    end
                end
            end
        end
    end
    table.sort(enemies, function(a, b) return a.distance < b.distance end)
    return enemies
end

local function selectTargets()
    local enemies = getAllEnemiesInRange()
    if #enemies == 0 then return {} end
    if targetMode == "Closest" then return { enemies[1] } end
    if targetMode == "Random"  then return { enemies[math.random(1, #enemies)] } end
    return enemies
end

